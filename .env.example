# --- Supabase (Project Settings > API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- Aplikasi ---
NEXT_PUBLIC_SITE_URL=https://kos-anda.vercel.app
# String acak panjang; Vercel Cron mengirimnya sebagai header Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# --- Email via Resend (https://resend.com) ---
RESEND_API_KEY=
EMAIL_FROM="Kos Keluarga <noreply@domain-anda.com>"

# --- WhatsApp via Fonnte (https://fonnte.com) ---
FONNTE_TOKEN=
